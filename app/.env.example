# Copia este archivo a `.env` y ajusta valores.
# cp .env.example .env

# Valores por defecto del wizard (paso Print). El operador puede cambiarlos en vivo.
# Nombre exacto de la impresora en Windows (Configuración → Impresoras)
FOTOMIRROR_PRINTER=DS-RX1

# 1 = el wizard sugiere "Simulación (no imprime)" como impresora inicial
FOTOMIRROR_PRINT_SIMULATE=0
