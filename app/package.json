{
  "name": "espejo-fotos",
  "version": "0.1.0",
  "private": true,
  "description": "Espejo fotográfico para eventos — offline, touch-first",
  "main": "dist-electron/main.js",
  "author": "FotoMirror",
  "scripts": {
    "dev": "dotenv -e .env -- vite",
    "dev:web": "VITE_WEB_ONLY=1 vite",
    "build": "tsc -b && vite build",
    "build:download-page": "vite build --config vite.download.config.ts",
    "build:portable": "npm run build:download-page && npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dist": "npm run build:portable",
    "dist:dir": "npm run build:download-page && npm run build && electron-builder --win dir",
    "postinstall": "electron-rebuild -f -w better-sqlite3 sharp"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.5.0",
    "pdf-to-printer": "^5.7.0",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@electron/rebuild": "^3.7.2",
    "dotenv-cli": "^8.0.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "mx.fotomirror.espejo",
    "productName": "Espejo Fotos",
    "copyright": "Copyright © FotoMirror",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/pdf-to-printer/**/*",
      "node_modules/pdfkit/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "../eventos",
        "to": "eventos",
        "filter": [
          "**/*",
          "!**/fotos/*.jpg",
          "!**/fotos/*.jpeg",
          "!**/fotos/*.png",
          "!**/fotos/*.webp"
        ]
      },
      {
        "from": "resources/tether-ptp2",
        "to": "tether-ptp2",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/download-page",
        "to": "download-page",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/brand",
        "to": "brand",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
